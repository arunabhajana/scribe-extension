{
  "manifest_version": 3,
  "name": "Scribe Notes",
  "version": "0.1.0",
  "description": "Quickly capture and organize notes from your browser.",
  "icons": {
    "16": "icons/16x16.png",
    "32": "icons/32x32.png",
    "48": "icons/48x48.png",
    "128": "icons/128x128.png"
  },
  "permissions": ["storage", "identity"],
  "host_permissions": ["https://*.supabase.co/*"],
  "background": {
    "service_worker": "background.js"
  },
  "action": {
    "default_icon": {
      "16": "icons/16x16.png",
      "32": "icons/32x32.png",
      "48": "icons/48x48.png"
    },
    "default_title": "Open Scribe Notes",
    "default_popup": "index.html"
  }
}
